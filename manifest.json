{
  "manifest_version": 3,
  "name": "Gemini Local Translator",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-local-translator@local.addon"
    }
  }
}
